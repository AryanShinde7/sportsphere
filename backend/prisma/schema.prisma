generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              Int             @id @default(autoincrement())
  name            String
  email           String          @unique
  phone           String?         @unique
  passwordHash    String
  role            String          @default("SUPPORTER")
  status          String          @default("ACTIVE")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  profileImageUrl String?
  bannerImageUrl  String?
  athleteProfile  AthleteProfile?
  sponsorProfile  SponsorProfile?
  supports        Support[]
  comments        Comment[]
}

model AthleteProfile {
  id                        Int                   @id @default(autoincrement())
  userId                    Int                   @unique
  sportId                   Int?
  discipline                String?
  city                      String?
  state                     String?
  bio                       String?
  coachName                 String?
  academyName               String?
  currentGoal               String?
  publicVerificationSummary String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  headline                  String?
  achievements              Achievement[]
  sport                     Sport?                @relation(fields: [sportId], references: [id])
  user                      User                  @relation(fields: [userId], references: [id])
  milestones                CareerMilestone[]
  mediaAssets               MediaAsset[]
  posts                     Post[]
  sponsorshipInterests      SponsorshipInterest[]
  supportRequests           SupportRequest[]
}

model SponsorProfile {
  id                   Int                   @id @default(autoincrement())
  userId               Int                   @unique
  organizationName     String
  organizationType     String?
  contactPerson        String?
  preferredSports      String?
  preferredRegions     String?
  budgetRange          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id])
  sponsorshipInterests SponsorshipInterest[]
}

model Sport {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  category String?
  athletes AthleteProfile[]
}

model Achievement {
  id                 Int            @id @default(autoincrement())
  athleteId          Int
  title              String
  competition        String?
  event              String?
  position           String?
  score              String?
  date               String?
  evidenceFileId     String?
  verificationStatus String         @default("NOT_SUBMITTED")
  verifiedBy         Int?
  verifiedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  achievementLevel   String?
  athlete            AthleteProfile @relation(fields: [athleteId], references: [id])
}

model SupportRequest {
  id              Int              @id @default(autoincrement())
  athleteId       Int
  title           String
  description     String?
  category        String
  targetAmount    Float
  deadline        DateTime?
  approvalStatus  String           @default("DRAFT")
  lifecycleStatus String           @default("ACTIVE")
  amountSupported Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  budgetItems     BudgetItem[]
  progressUpdates ProgressUpdate[]
  supports        Support[]
  athlete         AthleteProfile   @relation(fields: [athleteId], references: [id])
}

model BudgetItem {
  id               Int            @id @default(autoincrement())
  supportRequestId Int
  description      String
  amount           Float
  evidenceFileId   String?
  status           String         @default("PENDING")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  supportRequest   SupportRequest @relation(fields: [supportRequestId], references: [id])
}

model Support {
  id               Int            @id @default(autoincrement())
  supportRequestId Int
  supporterId      Int
  amount           Float
  transactionId    String?
  status           String         @default("INITIATED")
  createdAt        DateTime       @default(now())
  supporter        User           @relation(fields: [supporterId], references: [id])
  supportRequest   SupportRequest @relation(fields: [supportRequestId], references: [id])
  transaction      Transaction?
}

model ProgressUpdate {
  id                 Int            @id @default(autoincrement())
  supportRequestId   Int
  title              String
  description        String?
  evidenceFileId     String?
  verificationStatus String         @default("NOT_SUBMITTED")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  supportRequest     SupportRequest @relation(fields: [supportRequestId], references: [id])
}

model SponsorshipInterest {
  id               Int            @id @default(autoincrement())
  sponsorId        Int
  athleteId        Int
  supportRequestId Int?
  supportType      String
  proposedAmount   String?
  duration         String?
  requirements     String?
  message          String?
  status           String         @default("SUBMITTED")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  athlete          AthleteProfile @relation(fields: [athleteId], references: [id])
  sponsor          SponsorProfile @relation(fields: [sponsorId], references: [id])
}

model Verification {
  id         Int                    @id @default(autoincrement())
  entityType String
  entityId   Int
  category   String
  status     String                 @default("NOT_SUBMITTED")
  verifiedBy Int?
  verifiedAt DateTime?
  notes      String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  evidence   VerificationEvidence[]
}

model VerificationEvidence {
  id                Int          @id @default(autoincrement())
  verificationId    Int
  evidenceType      String
  privateStorageKey String?
  sourceUrl         String?
  originalFilename  String?
  uploadedAt        DateTime     @default(now())
  documentHash      String?
  verification      Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
}

model Transaction {
  id               Int      @id @default(autoincrement())
  supportId        Int      @unique
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  amount           Float
  currency         String   @default("INR")
  status           String   @default("CREATED")
  gatewayResponse  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  support          Support  @relation(fields: [supportId], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  entityType String
  entityId   Int
  details    String?
  createdAt  DateTime @default(now())
}

model MediaAsset {
  id        Int            @id @default(autoincrement())
  athleteId Int
  type      String
  url       String
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id])
}

model CareerMilestone {
  id             Int            @id @default(autoincrement())
  athleteId      Int
  year           Int
  title          String
  result         String?
  level          String
  certificateUrl String?
  createdAt      DateTime       @default(now())
  athlete        AthleteProfile @relation(fields: [athleteId], references: [id])
}

model Post {
  id        Int            @id @default(autoincrement())
  athleteId Int
  content   String
  mediaUrl  String?
  createdAt DateTime       @default(now())
  cheers    Cheer[]
  comments  Comment[]
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id])
}

model Cheer {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([postId, userId])
}

// ── Phase 8B: Comments on athlete journey updates ──
// Enabled for all authenticated users (athletes, supporters, sponsors, admins)
model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
